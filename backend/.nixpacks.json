{
  "phases": {
    "setup": {
      "nixPkgs": ["dotnet-sdk_8"]
    },
    "install": {
      "cmds": ["dotnet restore"]
    },
    "build": {
      "cmds": ["dotnet publish --no-restore -c Release -o out"]
    }
  },
  "start": {
    "cmd": "ASPNETCORE_URLS=http://0.0.0.0:$PORT ./out/FlexoAPP.API"
  }
}
