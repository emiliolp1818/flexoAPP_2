{
  "ConnectionStrings": {
    "DefaultConnection": "Server=${MYSQL_HOST};Port=${MYSQL_PORT};Database=${MYSQL_DATABASE};User=${MYSQL_USER};Password=${MYSQL_PASSWORD};AllowUserVariables=True;UseAffectedRows=False;SslMode=Required;ConnectionTimeout=60;DefaultCommandTimeout=90;Pooling=true;MinimumPoolSize=0;MaximumPoolSize=20;ConnectionIdleTimeout=300;ConnectionLifeTime=0;"
  },
  "JwtSettings": {
    "SecretKey": "FlexoAPP-Railway-Secret-Key-2024-Production-Ready-Ultra-Stable-Testing",
    "Issuer": "FlexoAPP",
    "Audience": "FlexoAPP-Users",
    "ExpirationMinutes": 1440,
    "RefreshTokenExpirationDays": 90,
    "AutoRefreshMinutes": 60,
    "RememberMeExpirationDays": 365
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning",
      "FlexoAPP": "Information"
    }
  },
  "AllowedHosts": "*",
  "Urls": "http://0.0.0.0:${PORT}",
  "FlexoAPP": {
    "ApplicationName": "FlexoAPP - Sistema de Gestión Flexográfica (Railway)",
    "Version": "2.0.0",
    "Environment": "Railway",
    "Features": {
      "EnableSwagger": true,
      "EnableSignalR": true,
      "EnableAudit": true,
      "EnableExcelImport": true,
      "EnableAutoReconnect": true,
      "EnableKeepAlive": true,
      "EnableHealthChecks": true,
      "EnableMachineBackup": true
    },
    "Stability": {
      "EnableConnectionPooling": true,
      "EnableRetryPolicy": true,
      "MaxRetryAttempts": 5,
      "RetryDelaySeconds": 2,
      "HealthCheckIntervalSeconds": 30,
      "AutoRestartOnFailure": true
    }
  },
  "BackupSettings": {
    "Path": "./Backups/Machines",
    "AutoBackupEnabled": true,
    "AutoBackupIntervalHours": 24,
    "MaxBackupRetentionDays": 30,
    "CompressBackups": true,
    "VerifyIntegrityOnCreate": true,
    "MaxBackupSizeMB": 100,
    "BackupFormats": ["zip", "json"],
    "NotificationSettings": {
      "EnableEmailNotifications": false,
      "NotifyOnSuccess": false,
      "NotifyOnFailure": true,
      "EmailRecipients": []
    }
  }
}
