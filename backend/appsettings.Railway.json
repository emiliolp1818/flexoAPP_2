{
  "ConnectionStrings": {
    "DefaultConnection": "Server=${MYSQL_HOST};Port=${MYSQL_PORT};Database=${MYSQL_DATABASE};User=${MYSQL_USER};Password=${MYSQL_PASSWORD};AllowUserVariables=True;UseAffectedRows=False;SslMode=Required;ConnectionTimeout=30;DefaultCommandTimeout=60;Pooling=true;MinimumPoolSize=5;MaximumPoolSize=50;ConnectionIdleTimeout=180;ConnectionLifeTime=600;ConnectionReset=true;AllowLoadLocalInfile=false;AllowPublicKeyRetrieval=false;"
  },
  "JwtSettings": {
    "SecretKey": "FlexoAPP-Railway-Secret-Key-2024-Production-Ready-Ultra-Stable-Testing",
    "Issuer": "FlexoAPP",
    "Audience": "FlexoAPP-Users",
    "ExpirationMinutes": 1440,
    "RefreshTokenExpirationDays": 90,
    "AutoRefreshMinutes": 60,
    "RememberMeExpirationDays": 365
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Error",
      "FlexoAPP": "Information",
      "System.Net.Http.HttpClient": "Warning",
      "Microsoft.AspNetCore.SignalR": "Warning",
      "Microsoft.AspNetCore.Http.Connections": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Urls": "http://0.0.0.0:${PORT}",
  "FlexoAPP": {
    "ApplicationName": "FlexoAPP - Sistema de Gestión Flexográfica (Railway)",
    "Version": "2.1.0",
    "Environment": "Railway",
    "Features": {
      "EnableSwagger": true,
      "EnableSignalR": true,
      "EnableAudit": true,
      "EnableExcelImport": true,
      "EnableAutoReconnect": true,
      "EnableKeepAlive": true,
      "EnableHealthChecks": true,
      "EnableMachineBackup": true
    },
    "Performance": {
      "EnableResponseCompression": true,
      "CompressionLevel": "Fastest",
      "EnableResponseCaching": true,
      "CacheDurationSeconds": 60,
      "MaxConcurrentConnections": 100,
      "RequestTimeoutSeconds": 120
    },
    "Stability": {
      "EnableConnectionPooling": true,
      "EnableRetryPolicy": true,
      "MaxRetryAttempts": 3,
      "RetryDelaySeconds": 2,
      "HealthCheckIntervalSeconds": 30,
      "AutoRestartOnFailure": true
    }
  },
  "BackupSettings": {
    "Path": "./Backups/Machines",
    "AutoBackupEnabled": false,
    "AutoBackupIntervalHours": 24,
    "MaxBackupRetentionDays": 30,
    "CompressBackups": true,
    "VerifyIntegrityOnCreate": false,
    "MaxBackupSizeMB": 50,
    "BackupFormats": ["json"],
    "NotificationSettings": {
      "EnableEmailNotifications": false,
      "NotifyOnSuccess": false,
      "NotifyOnFailure": false,
      "EmailRecipients": []
    }
  }
}
